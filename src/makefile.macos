# Build Sdtty on macOS with the Xcode command-line tools.
# Run from src: make -f makefile.macos

CXX = clang++
CXXFLAGS = -O2 -std=c++17 -Wall -Wno-switch -Wno-uninitialized -Wno-char-subscripts -Wno-narrowing
# Switches intentionally handle subsets of the setup/concept enums.

SD_OBJS = sdmain.o sdutil.o sdbasic.o sdinit.o \
          sdtables.o sdctable.o sdtop.o sdconcpt.o sdpreds.o \
          sdgetout.o sdmoves.o sdtand.o sdconc.o sdistort.o \
          sdpick.o sdsi.o mapcachefile.o common.o
TTY_OBJS = sdui-tty.o sdmatch.o sdui-ttu.o
MKCALLS_OBJS = mkcalls.o common.o
OBJS = $(sort $(SD_OBJS) $(TTY_OBJS) $(MKCALLS_OBJS))
DEPS = $(OBJS:.o=.d)

.PHONY: all clean test-compass test-compass-roll test-compass-run test-compass-trade test-compass-quarter test-compass-press
all: sdtty sd_calls.dat

sdtty: $(SD_OBJS) $(TTY_OBJS)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $^ $(LDLIBS)

mkcalls: $(MKCALLS_OBJS)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $^ $(LDLIBS)

sd_calls.dat: sd_calls.txt mkcalls
	./mkcalls ./sd_calls.txt

%.o: %.cpp
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -MMD -MP -c $< -o $@

-include $(DEPS)

test-compass-press: all
	python3 ../tests/compass_press.py

test-compass-quarter: all
	python3 ../tests/compass_quarter.py

test-compass-trade: all
	python3 ../tests/compass_trade.py

test-compass-run: all
	python3 ../tests/compass_run.py

test-compass-roll: all
	python3 ../tests/compass_roll_to_wave.py

test-compass: compass-selectors-test
	./compass-selectors-test

sdui-tty-test.o: sdui-tty.cpp $(wildcard *.h)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -Dmain=sdtty_program_main -c $< -o $@

compass-selectors-test: ../tests/compass_selectors.cpp $(wildcard *.h) $(SD_OBJS) sdmatch.o sdui-ttu.o sdui-tty-test.o
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -UNDEBUG -I. $(LDFLAGS) -o $@ $< $(SD_OBJS) sdmatch.o sdui-ttu.o sdui-tty-test.o $(LDLIBS)

clean:
	$(RM) $(OBJS) $(DEPS) sdtty mkcalls sd_calls.dat sdui-tty-test.o compass-selectors-test
